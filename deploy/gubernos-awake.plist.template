<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keeps the Mac awake on AC power so Gubernos (its background service) stays reachable from the phone.
       -s: prevent system sleep on AC only (battery behaves normally); display still sleeps. Closing the lid still sleeps. -->
  <key>Label</key><string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/caffeinate</string><string>-s</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
